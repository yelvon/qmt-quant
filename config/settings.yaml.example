qmt:
  install_dir: "C:\\qmt"
  # ARM64 主机：安装 Python 3.11 x64 + pip install xtquant，并启动 MiniQMT (XtMiniQmt)
  xtquant_site_packages: ""
  xtquant_port: 58610
  userdata_path: ""
  account_id: ""

python:
  qmt_env: ""      # x64 Python 3.11+ (bridge)，或 QMT bin.x64/pythonw.exe
  quant_env: ""    # path to quant-env python.exe (3.12+)

data:
  db_url: "postgresql://qmt:qmt@localhost:5432/qmt_quant"
  parquet_catalog_dir: "data/catalog"
  catalog_nt_dir: "data/catalog_nt"
  export_nt_catalog: false
  watchlist_path: "config/watchlist.txt"
  default_sector: "沪深A股"
  bar_adjust_type: "front"
  sync_batch_size: 50
  auto_export_catalog: true
  sync:
    incremental_days: 5
    stale_trading_days: 3
    gap_scan_lookback: "3y"
    completeness_threshold: 0.85
    auto_repair: false
    auto_repair_max_codes: 200
    # 同步并发：1=安全默认（MiniQMT 单连接）；2~4 可加速全量但可能不稳定
    concurrency: 1

backtest:
  initial_cash: 1000000
  commission_rate: 0.0003
  stamp_tax_rate: 0.001
  min_commission: 5.0
  transfer_fee_rate: 0.00002
  slippage_bps: 5
  match_price: "next_open"
  max_weight_per_symbol: 0.1
  validation_engine: "custom"   # custom | nautilus

trade:
  dry_run: true

jobs:
  inline: false
  force_subprocess_for_qmt: true

web:
  host: "127.0.0.1"
  port: 8788
  api_token: ""   # optional Bearer token for POST/PUT API
  cors_origins: "http://localhost:5173,http://127.0.0.1:5173"
